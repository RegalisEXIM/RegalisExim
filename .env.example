# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=regalis_exports

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# First administrator. Used by npm run seed-admin (see README).
ADMIN_EMAIL=admin@regalisexports.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
